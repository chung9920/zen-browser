# Template file for 'zen-browser'
pkgname=zen-browser
version=1.21.9b
revision=1
archs="x86_64"
meta=yes
short_desc="Minimalistic web browser"
maintainer="chung9920 <ngodh03344@gmail.com>"
license="MPL-2.0"
homepage="https://www.zen-browser.app/"
distfiles="https://github.com/zen-browser/desktop/releases/download/${version}/zen.linux-x86_64.tar.xz"
checksum=f83b1467c421a2d0d53eebd2c24c747b1836f02a0d043dd8b8862392adbf6e01

# Add the necessary dependencies if there are any
depends="libX11 libXcomposite libXdamage libXext libXfixes libXt libXtst \
libxkbcommon libxkbcommon-x11 libpng glib gtk+3"

do_install() {
	# Install the files
	vmkdir usr/lib/zen-browser
	vcopy * usr/lib/zen-browser

	# icons
  for i in 16x16 22x22 24x24 32x32 48x48 128x128 256x256; do
		vinstall "${DESTDIR}/usr/lib/zen-browser/browser/chrome/icons/default${i}.png" 644 \
			"usr/share/icons/hicolor/${i}/apps zen-browser.png"
	done

	# install .desktop file
	vinstall "${FILESDIR}/zen.desktop" 644 usr/share/applications

	# link the binary
	vmkdir usr/bin/
	ln -s /usr/lib/zen-browser/zen ${DESTDIR}/usr/bin/
}


